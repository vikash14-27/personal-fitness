# Copy to .env and export it if you want to override the defaults in
# backend/src/main/resources/application.yml. The defaults are enough
# for a local MongoDB on port 27017.

MONGODB_URI=mongodb://localhost:27017/fitness
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# NVIDIA NIM, OpenAI-compatible API at https://integrate.api.nvidia.com/v1.
# Used for free-text meal estimates. Leave blank to log meals by hand:
# the API returns a clear error and the form stays usable.
# Do not commit a real key. This file is an example; .env is gitignored.
NVIDIA_API_KEY=
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_TIMEOUT_SECONDS=25
