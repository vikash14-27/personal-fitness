# Copy to .env and export it if you want to override the defaults in
# backend/src/main/resources/application.yml. The defaults are enough
# for a local MongoDB on port 27017.

MONGODB_URI=mongodb://localhost:27017/fitness
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reserved for later sprints (NVIDIA NIM meal estimates and weekly tips).
# This app does not read or send this value.
NVIDIA_API_KEY=
